{
  "expo": {
    "name": "ShopWithEzz",
    "slug": "ShopWithEzzV1Final",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/shopwithezz-icon.png",
    "scheme": "shopwithezz",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/shopwithezz-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "mimeType": "application/vnd.shopwithezz.list+json"
            }
          ]
        }
      ],
      "package": "com.lalli61.ShopWithEzzV2"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/shopwithezz-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow ShopWithEzz to use the microphone for adding and searching shopping items.",
          "speechRecognitionPermission": "Allow ShopWithEzz to convert spoken shopping items into text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/shopwithezz-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "image/*",
            "application/vnd.shopwithezz.list+json"
          ],
          "disableIOS": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
